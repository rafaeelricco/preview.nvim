{
  "runtime": {
    "version": "LuaJIT"
  },
  "workspace": {
    "library": ["$VIMRUNTIME/lua", "${3rd}/luv/library"],
    "checkThirdParty": false
  },
  "diagnostics": {
    "globals": [
      "vim",
      "describe",
      "it",
      "before_each",
      "after_each",
      "assert"
    ]
  },
  "type": {
    "checkTableShape": true
  }
}
